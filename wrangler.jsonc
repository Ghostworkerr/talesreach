// Cloudflare Workers settings: serve the built game client as static files.
// Cloudflare runs `npm run build:client`, then `npx wrangler deploy` with this file.
{
  "name": "talesreach",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application"
  }
}
